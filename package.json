{
  "name": "screen-watermark",
  "version": "1.0.0",
  "description": "A simple screen watermark application.",
  "main": "main.js",
  "engines": {
    "node": ">=18 <23"
  },
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "clean": "node scripts/clean.js",
    "package": "node scripts/package.js",
    "package:mac": "node scripts/package.js --platform=darwin --arch=x64",
    "package:win": "node scripts/package.js --platform=win32 --arch=x64",
    "package:linux": "node scripts/package.js --platform=linux --arch=x64"
  },
  "keywords": [
    "Electron",
    "watermark",
    "screen"
  ],
  "author": "ajiavt",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "@electron/packager": "^18.3.6"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  }
}
